{
  "name": "zgent",
  "version": "0.1.0",
  "private": true,
  "bin": { "zgent": "bin/zgent" },
  "packageManager": "pnpm@10.26.1",
  "engines": { "node": ">=26.13.0 <27" },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm --filter @zgent/contracts check && tsc --noEmit && pnpm --filter @zgent/daemon test",
    "start": "pnpm --filter @zgent/daemon start"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
