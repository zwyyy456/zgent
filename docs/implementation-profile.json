{
  "design_version": "1.1",
  "contract_schema_version": "1",
  "platforms": {
    "current": [
      "macos",
      "linux"
    ],
    "excluded": [
      "windows"
    ]
  },
  "workspaces": [
    "apps/daemon",
    "apps/console",
    "apps/tui",
    "packages/contracts"
  ],
  "mcp_clients": [
    "official_antigravity",
    "official_claude_code"
  ],
  "worker_adapters": [
    "codex_app_server",
    "claude_agent_sdk"
  ],
  "enabled_tools": [
    "delegate_task",
    "get_task",
    "wait_tasks",
    "send_to_task",
    "cancel_task",
    "list_profiles",
    "list_tasks"
  ],
  "task_attempts": {
    "maximum_per_task": 1,
    "automatic_retry": false,
    "live_process_reattachment": false
  },
  "concurrency": {
    "global": 2,
    "per_project": 2
  },
  "console": {
    "updates": "sse_replay_with_snapshot_polling",
    "poll_interval_ms": 1500,
    "authentication": "owner_socket_bootstraps_browser_session",
    "restart_invalidates_session": true,
    "csrf_required": true,
    "mutation_origin": "exact"
  },
  "enabled_http_paths": [
    "/healthz",
    "/console/link",
    "/daemon/stop",
    "/api/v1/projects",
    "/api/v1/readiness",
    "/api/v1/tasks",
    "/api/v1/tasks/{task_id}",
    "/api/v1/requests/{request_id}",
    "/api/v1/requests/{request_id}/decision",
    "/api/v1/tasks/{task_id}/cancel",
    "/api/v1/tasks/{task_id}/review",
    "/api/v1/artifacts/{artifact_id}",
    "/api/v1/profiles",
    "/api/v1/events",
    "/api/v1/model-catalog",
    "/api/v1/tasks/{task_id}/workspace",
    "/api/v1/tasks/{task_id}/confirm-stopped",
    "/api/v1/tasks/{task_id}/remove-workspace",
    "/api/v1/tasks/{task_id}/apply",
    "/api/v1/tasks/{task_id}/discard",
    "/api/v1/tasks/{task_id}/resolve-application",
    "/api/v1/workspaces",
    "/api/v1/session-profiles",
    "/api/v1/sessions",
    "/api/v1/sessions/{session_id}",
    "/api/v1/sessions/{session_id}/stream",
    "/api/v1/sessions/{session_id}/turn",
    "/api/v1/sessions/{session_id}/profile",
    "/api/v1/sessions/{session_id}/models",
    "/api/v1/sessions/{session_id}/preferences",
    "/api/v1/sessions/{session_id}/explain-approval",
    "/api/v1/sessions/{session_id}/summary",
    "/api/v1/sessions/{session_id}/interrupt",
    "/api/v1/sessions/{session_id}/cancel-group",
    "/api/v1/sessions/{session_id}/close"
  ],
  "reserved_request_kinds": [
    "billing_confirmation"
  ],
  "database": {
    "schema": "apps/daemon/src/db/schema.sql",
    "table_count": 22,
    "registry_source": "local_git_checkouts_and_config_overrides",
    "management_crud_ui": false,
    "durable_events": true,
    "outbox_dispatcher": false,
    "migrations": [
      "apps/daemon/src/db/sessions.sql",
      "apps/daemon/src/db/personal.sql"
    ]
  },
  "scope": "Configured v1.1 capabilities. Live provider, official client, and platform acceptance are tracked separately.",
  "main_session_adapters": [
    "antigravity_acp",
    "claude_agent_sdk"
  ],
  "implemented_extensions": [
    "custom_chat",
    "mcp_apps",
    "sse_replay",
    "tracked_dirty_snapshot",
    "codex_persistent_context",
    "owner_workspace_reconciliation",
    "owner_clean_worktree_removal",
    "explicit_project_control_grants",
    "terminal_owner_socket",
    "dynamic_projects",
    "turn_workspace_snapshots",
    "personal_apply_and_discard"
  ],
  "conditional_extensions": [
    "independent_gemini_api_automation",
    "host_native_mcp_tasks",
    "host_native_approval_elicitation"
  ]
}
